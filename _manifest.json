{
  "manifest_version": 2,
  "id": "cssqy.token-usage-report",
  "version": "1.10.0",
  "name": "Token 用量统计与播报",
  "description": "统计 Bot 的 Token 消耗，支持会话维度筛选、图片报告、每日定时播报与 LLM 风格化转述",
  "author": {
    "name": "CSSQY",
    "url": "https://github.com/CSSQY"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/CSSQY/token_usage_report",
    "homepage": "https://github.com/CSSQY/token_usage_report",
    "documentation": "https://github.com/CSSQY/token_usage_report/blob/main/README.md",
    "issues": "https://github.com/CSSQY/token_usage_report/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=12.3.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.get_all_streams",
    "chat.open_session",
    "config.get",
    "llm.generate",
    "render.html2png",
    "statistics.local.token_trend",
    "statistics.local.model_trend",
    "statistics.local.models",
    "statistics.local.token_distribution",
    "statistics.local.message_trend",
    "statistics.local.tool_trend",
    "database.get",
    "database.count"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
